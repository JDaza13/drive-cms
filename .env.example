# Copy to .env.local for `pnpm dev` (or .dev.vars for `wrangler pages dev`).
# On Vercel / Cloudflare, set these in the project's environment variables.

# "demo" serves built-in sample posts; "drive" reads the folder below.
# Leave empty to use Drive when both values below are set, demo otherwise.
FEED_SOURCE=demo

# The id at the end of https://drive.google.com/drive/folders/<id>
DRIVE_FOLDER_ID=

# The service account's JSON key, on one line, wrapped in single quotes.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional: items in the feed (1-50, default 20) and CDN cache seconds (default 300).
FEED_LIMIT=20
FEED_CACHE_SECONDS=300
